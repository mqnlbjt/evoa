{
	"name": "@wqqqyyz/evoa",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"evoa": "dist/cli.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"build:web": "npm --prefix web run build",
		"dev:web": "npm --prefix web run dev",
		"prepublishOnly": "npm run build && npm run build:web",
		"test": "npx vitest --run",
		"test:unit": "npx vitest --run --reporter=verbose",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"better-sqlite3": "^12.9.0",
		"esbuild": "^0.28.0",
		"openai": "^6.34.0",
		"ws": "^8.21.3",
		"yaml": "^2.8.4"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.3.0",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "^3.2.7",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"description": "A lightweight, evaluable, verifiable, and self-evolving general-purpose Agent runtime.",
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"dist/**/*.js.map",
		"web/dist/**"
	],
	"keywords": [
		"agent",
		"ai-agent",
		"agent-runtime",
		"benchmark",
		"evolution",
		"llm",
		"typescript"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mqnlbjt/evoa.git"
	},
	"homepage": "https://github.com/mqnlbjt/evoa#readme",
	"bugs": {
		"url": "https://github.com/mqnlbjt/evoa/issues"
	}
}
